# --- Azure AI Foundry ---
# Your Foundry project endpoint (Foundry portal -> project -> Overview).
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
# The model deployment name from your Foundry project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
# Parent Foundry account resource ID (required by lab 5 for its unique RAI policy).
AZURE_AI_ACCOUNT_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account-name>

# --- Azure AI Search / Foundry IQ (labs 3, 4, 6, 12, 13) ---
# The Search service holding the index and the knowledge base.
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
# The index the guidelines were chunked into (lab 3).
AZURE_SEARCH_INDEX_NAME=who-guidelines-index
# The knowledge base built over that index.
AZURE_SEARCH_KNOWLEDGE_BASE=umc-medical-kb
# The project connection an agent uses to authenticate to the knowledge base.
AZURE_KB_CONNECTION_NAME=who-kb-mcp