# --- Azure AI Foundry ---
# Your Foundry project endpoint (Foundry portal -> project -> Overview).
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
# The model deployment name from your Foundry project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-nano
# Optional: defaults to the project's default Azure AI Search connection and "who" index.
AZURE_AI_SEARCH_CONNECTION_NAME=
AZURE_AI_SEARCH_ENDPOINT=https://umc-hackathon-devbox-fiq-search.search.windows.net
AZURE_AI_SEARCH_INDEX_NAME=who

# --- API ---
# Comma-separated frontend origins allowed by CORS.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum duration of one orchestration run, in seconds.
ORCHESTRATION_TIMEOUT_SECONDS=300
